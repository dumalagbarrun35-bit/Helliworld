            vy = rng:NextNumber(0.01, 0.04), vx = rng:NextNumber(-0.008, 0.008),
            tw = rng:NextNumber(0.6, 2.2), ph = rng:NextNumber(0, 6.28),
        }
    end
    for _ = 1, 6 do
        local s = rng:NextInteger(90, 190)
        local f = new(loadstring(base64decode("RnJhbWU="))(), {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(s, s),
            BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.9,
            BorderSizePixel = 0, Parent = layer,
        })
        corner(f, s)
        orbs[#orbs + 1] = {
            f = f, Wi2gF0Ma = rng:NextNumber(), bkHtsWq6 = rng:NextNumber(),
            vx = rng:NextNumber(-0.02, 0.02), vy = rng:NextNumber(-0.02, 0.02),
            tw = rng:NextNumber(0.3, 1), ph = rng:NextNumber(0, 6.28),
        }
    end

    local t, conn = 0, nil
    local function step(dt)
        if not Main.Visible then return end
        t = t + dt
        if Cfg.space then
            for _, s in ipairs(stars) do
                s.bkHtsWq6 = s.bkHtsWq6 + s.vy * dt
                s.Wi2gF0Ma = s.Wi2gF0Ma + s.vx * dt
                if s.bkHtsWq6 > 1.02 then s.bkHtsWq6 = -0.02; s.Wi2gF0Ma = rng:NextNumber() end
                if s.Wi2gF0Ma < -0.02 then s.Wi2gF0Ma = 1.02 elseif s.Wi2gF0Ma > 1.02 then s.Wi2gF0Ma = -0.02 end
                s.f.Position = UDim2.fromScale(s.Wi2gF0Ma, s.bkHtsWq6)
                s.f.BackgroundTransparency = 0.2 + 0.7 * (0.5 + 0.5 * math.sin(t * s.tw + s.ph))
            end
        end
        if Cfg.ambient then
            for _, o in ipairs(orbs) do
                o.Wi2gF0Ma = o.Wi2gF0Ma + o.vx * dt
                o.bkHtsWq6 = o.bkHtsWq6 + o.vy * dt
                if o.Wi2gF0Ma < -0.2 then o.vx = math.abs(o.vx) elseif o.Wi2gF0Ma > 1.2 then o.vx = -math.abs(o.vx) end
                if o.bkHtsWq6 < -0.2 then o.vy = math.abs(o.vy) elseif o.bkHtsWq6 > 1.2 then o.vy = -math.abs(o.vy) end
                o.f.Position = UDim2.fromScale(o.Wi2gF0Ma, o.bkHtsWq6)
                o.f.BackgroundTransparency = 0.88 + 0.06 * math.sin(t * o.tw + o.ph)
            end
        end
    end

    function Particles.apply()
        local en = Cfg.particles
        layer.Visible = en
        for _, s in ipairs(stars) do s.f.Visible = en and Cfg.space end
        for _, o in ipairs(orbs) do o.f.Visible = en and Cfg.ambient end
        if en and not conn then
            conn = RunService.Heartbeat:Connect(step)
        elseif not en and conn then
            conn:Disconnect()
            conn = nil
        end
    end

    hooks[#hooks + 1] = function()
        for _, s in ipairs(stars) do s.f.BackgroundColor3 = Theme.Text end
        for _, o in ipairs(orbs) do o.f.BackgroundColor3 = Theme.Accent end
    end
    Cleanups[#Cleanups + 1] = function() if conn then conn:Disconnect() end end
end

