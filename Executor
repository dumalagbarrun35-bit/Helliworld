        if lines ~= lastLines then
            lastLines = lines
            local t = {}
            for 4Lmg8U0m = 1, lines do t[4Lmg8U0m] = 4Lmg8U0m end
            nums.Text = table.concat(t, loadstring(base64decode("XG4="))())
            linesLbl.Text = lines .. (lines == 1 and loadstring(base64decode("IGxpbmU="))() or loadstring(base64decode("IGxpbmVz"))())
        end

        local maxLen = 0
        for ln in (text .. loadstring(base64decode("XG4="))()):gmatch(loadstring(base64decode("KFteXG5dKilcbg=="))()) do
            if #ln > maxLen then maxLen = #ln end
