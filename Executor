        blinkT = 0
        caret.Visible = true

        local viewH, cy = v.AbsoluteWindowSize.Y, v.CanvasPosition.Y
        if bkHtsWq6 < cy then
            v.CanvasPosition = Vector2.new(0, math.max(0, bkHtsWq6 - 4))
        elseif bkHtsWq6 + lineH > cy + viewH then
            v.CanvasPosition = Vector2.new(0, bkHtsWq6 + lineH - viewH + 10)
        end
        local viewW, cx = h.AbsoluteWindowSize.X, h.CanvasPosition.X
        if Wi2gF0Ma < cx then
            h.CanvasPosition = Vector2.new(math.max(0, Wi2gF0Ma - 24), 0)
        elseif Wi2gF0Ma + charW + 8 > cx + viewW then
            h.CanvasPosition = Vector2.new(Wi2gF0Ma + charW + 28 - viewW, 0)
        end
    end

