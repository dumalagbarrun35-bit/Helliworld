local function makeDraggable(handle, target, onTap, onDragEnd)
    local dragging, moved, startMouse, startPos = false, false, nil, nil
    on(handle.InputBegan, function(input)
        local ut = input.UserInputType
        if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
            dragging, moved = true, false
            startMouse, startPos = input.Position, target.Position
        end
    end)
    on(UIS.InputChanged, function(input)
        if not dragging then return end
        local ut = input.UserInputType
        if ut == Enum.UserInputType.MouseMovement or ut == Enum.UserInputType.Touch then
            local d = input.Position - startMouse
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    on(UIS.InputEnded, function(input)
        local ut = input.UserInputType
        if dragging and (ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch) then
            dragging = false
            if not moved and onTap then onTap() end
            if moved and onDragEnd then onDragEnd() end
        end
    end)
end

