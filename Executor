local function execute()
    local src = Editor.getText()
    if not src:find(loadstring(base64decode("JVM="))()) then
        Console.log(loadstring(base64decode("d2Fybg=="))(), loadstring(base64decode("Tm90aGluZyB0byBleGVjdXRlLg=="))())
        return
    end
    local loader = loadstring or load
    if not loader then
        Console.log(loadstring(base64decode("ZXJyb3I="))(), loadstring(base64decode("VGhpcyBleGVjdXRvciBkb2VzIG5vdCBzdXBwb3J0IGxvYWRzdHJpbmcu"))())
        return
    end
    local fn, err = loader(src)
    if not fn then
        Console.log(loadstring(base64decode("ZXJyb3I="))(), tostring(err))
        return
    end
    Console.log(loadstring(base64decode("aW5mbw=="))(), loadstring(base64decode("RXhlY3V0aW5nIA=="))() .. (Tabs[activeIdx] and Tabs[activeIdx].name or loadstring(base64decode("c2NyaXB0"))()) .. loadstring(base64decode("Li4u"))())

    local hooked = false
    pcall(function()
        local base = getfenv(fn)
        local env = setmetatable({
            print = function(...)
                Console.log(loadstring(base64decode("cHJpbnQ="))(), fmt(...))
                return print(...)
            end,
            warn = function(...)
                Console.log(loadstring(base64decode("d2Fybg=="))(), fmt(...))
                return warn(...)
            end,
        }, { __index = base, __newindex = base })
        setfenv(fn, env)
        hooked = true
    end)

    local logConn
    if not hooked then
        logConn = LogService.MessageOut:Connect(function(m, t)
            local kind = loadstring(base64decode("cHJpbnQ="))()
            if t == Enum.MessageType.MessageError then kind = loadstring(base64decode("ZXJyb3I="))()
            elseif t == Enum.MessageType.MessageWarning then kind = loadstring(base64decode("d2Fybg=="))() end
            Console.log(kind, m)
        end)
    end

    task.spawn(function()
        local ok, e = xpcall(fn, function(m) return tostring(m) end)
        if not ok then Console.log(loadstring(base64decode("ZXJyb3I="))(), e) end
        if logConn then
            task.delay(1, function() logConn:Disconnect() end)
        end
    end)
end
