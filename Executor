    local blinkT = 0
    local function updateCaret()
        local pos = box.CursorPosition
        if pos < 1 or not box:IsFocused() then
            caret.Visible = false
            return
        end
        local before = box.Text:sub(1, pos - 1)
        local _, nl = before:gsub(loadstring(base64decode("XG4="))(), loadstring(base64decode(""))())
        local lastNl = before:match(loadstring(base64decode("LiooKVxu"))())
        local col = #before - (lastNl or 0)
